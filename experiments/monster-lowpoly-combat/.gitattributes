# Frozen scripts, geometry and receipts preserve exact byte hashes across checkouts.
*.mjs -text
*.lua -text
*.py -text
*.json -text
*.md text eol=lf
*.png filter=lfs diff=lfs merge=lfs -text
# Frozen Windows evidence intentionally contains CRLF; retain real whitespace checks.
** whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
