+// Only the complete approved release-trigger wrapper may project to its predecessor.
+import {createHash} from 'node:crypto';
+import {readFileSync} from 'node:fs';
+const hash=value=>createHash('sha256').update(value).digest('hex');
+const current='1421c47e483f9d85bf6dea031db6721ac8df7dc039c4017272dbb83eb3c6958a';
+const previous='427d7578284ef86a85b994a5df140a328847fb990b368a798200e082cb4e26ab';
+export function beforeReleaseQualityWorkflow(source){
+ if(typeof source!=='string')return source;
+ const normalized=source.replaceAll('\r\n','\n');
+ if(hash(normalized)!==current)return source;
+ const prior=normalized.replaceAll("branches: [develop, master, 'release/**']",'branches: [develop, master]');
+ if(hash(prior)!==previous)return source;
+ // Reject mixed line endings, rather than silently repairing malformed input.
+ const crlf=source.includes('\r\n');
+ if(crlf&&source!==normalized.replaceAll('\n','\r\n'))return source;
+ return crlf?prior.replaceAll('\n','\r\n'):prior;
+}
+export function releaseQualityPriorRead(read=readFileSync){
+ return (path,encoding)=>{
+  const value=read(path,encoding);
+  if(path!=='.github/workflows/quality.yml')return value;
+  const source=typeof value==='string'?value:value.toString('utf8');
+  const prior=beforeReleaseQualityWorkflow(source);
+  return prior===source?value:typeof value==='string'?prior:Buffer.from(prior);
+ };
+}
