+test('frozen native candidate rejects spoofed or ambiguous bundled versions before any SDK access',async t=>{
+  for(const [label,source]of [
+    ['wrong bare version','return {codeVersion="v0.0.1"}'],
+    ['unprefixed version','return {codeVersion="0.1.1"}'],
+    ['missing bare version','return {copy="说明"}'],
+    ['comment spoof','-- ["codeVersion"]="v0.1.1"\nreturn {}'],
+    ['nested spoof','return {nested={["codeVersion"]="v0.1.1"}}'],
+    ['string spoof',`return {copy='["codeVersion"]="v0.1.1"'}`],
+    ['duplicate mixed key','return {["codeVersion"]="v0.1.1",codeVersion="v0.0.1"}'],
+    ['duplicate correct key','return {codeVersion="v0.1.1",["codeVersion"]="v0.1.1"}'],
+    ['dynamic root key','return {["codeVersion"]="v0.1.1",[("code".."Version")]="v0.0.1"}'],
+    ['dynamic version','return {codeVersion=(function() error("must not execute") end)()}'],
+    ['post-construction mutation','local x={["codeVersion"]="v0.1.1"};x.codeVersion="v0.0.1";return x'],
+    ['extra return value','return {["codeVersion"]="v0.1.1"},{}'],
+    ['invalid Lua','return {["codeVersion"]="v0.1.1"'],
+  ]){
+    const f=await releaseFixture(t,false,undefined,()=>source);
+    await assert.rejects(f.run(),/Bundled code version differs/,label);
+    assert.equal(f.resources.length,0,label+' must reject before SDK resources');
+    assert.equal(f.calls.length,0,label+' must reject before SDK calls');
+    assert.equal(existsSync(join(f.output,'candidate.json')),false,label+' cannot publish a success receipt');
+  }
+});
