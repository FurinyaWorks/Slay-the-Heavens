+function assertBundledCodeVersion(source,version) {
+  // Only the RC path needs the locked parser; dependency-free layout imports stay unchanged.
+  // Parse generated Lua as data, never execute it or accept matches in comments/nested values.
+  const luaparse=createRequire(import.meta.url)('luaparse');
+  let chunk;
+  try { chunk=luaparse.parse(Buffer.from(source).toString('latin1'),{luaVersion:'5.3',encodingMode:'pseudo-latin1'}); }
+  catch { throw new Error('Bundled code version differs from candidate provenance'); }
+  const returned=chunk.body.length===1&&chunk.body[0];
+  const table=returned?.type==='ReturnStatement'&&returned.arguments.length===1&&returned.arguments[0];
+  if(table?.type!=='TableConstructorExpression')throw new Error('Bundled code version differs from candidate provenance');
+  const keys=new Set();let bundled;
+  for(const field of table.fields) {
+    const key=field.type==='TableKeyString'?field.key.name:field.type==='TableKey'&&field.key.type==='StringLiteral'?field.key.value:null;
+    if(typeof key!=='string'||keys.has(key))throw new Error('Bundled code version differs from candidate provenance');
+    keys.add(key);
+    if(key==='codeVersion')bundled=field.value.type==='StringLiteral'?field.value.value:null;
+  }
+  if(bundled!==version)throw new Error('Bundled code version differs from candidate provenance');
+}
