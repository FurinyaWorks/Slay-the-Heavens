+// CI-only explicit union. Original PC/bootstrap archives and leaves stay immutable.
+// This trust leaf is excluded from its own packet; no production reader imports it.
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {createHash} from 'node:crypto';
+import {gunzipSync} from 'node:zlib';
+import {releasePcPriorInventory,assertReleasePcCiCurrent} from './release-pc-ci-source.mjs';
+import {assertReleaseBootstrapCiCurrent} from './release-bootstrap-ci-source.mjs';
+const hash=b=>createHash('sha256').update(b).digest('hex'),norm=s=>s.replaceAll('\r\n','\n');
+const bytes=readFileSync(new URL('./release-pc-bootstrap-ci-source.json.gz',import.meta.url));
+assert.equal(hash(bytes),'701665c217a582af74f3ce182f5262fafa22f1832fb7fc60c830add07931be99','complete PC bootstrap union');
+const packet=JSON.parse(gunzipSync(bytes));
+assert.equal(packet.schemaVersion,1);assert.equal(packet.normalization,'LF');
+assert.deepEqual(packet.heads,{pc:'00ff9b272625942a4d1f22085722142baac9ee2f',bootstrap:'b67226945c2be47c8fff31f1362412b973f68875'});
+assert.equal(packet.currentTreeCommitted,false,'isolated union is not a published commit');
+for(const [path,row]of Object.entries(packet.files))for(const b of [row.current,row.before,...Object.values(row.views)].filter(Boolean)){
+ assert.equal(b.source,norm(b.source),path);assert.equal(hash(b.source),b.sha256,path);
+ assert.equal(createHash('sha1').update(`blob ${Buffer.byteLength(b.source)}\0`).update(b.source).digest('hex'),b.gitBlob,path);
+}
+const freeze=v=>{if(v&&typeof v==='object'&&!Object.isFrozen(v)){Object.values(v).forEach(freeze);Object.freeze(v);}return v;};
+export const releaseUnionCiPacket=freeze(packet);
+const rowFor=path=>Object.hasOwn(packet.files,path)?packet.files[path]:null;
+const exact=(row,source)=>row&&typeof source==='string'&&!source.includes('\r\r\n')&&hash(norm(source))===row.current.sha256;
+export function releaseUnionViewSource(path,source,view){
+ assert(['pc','bootstrap'].includes(view));const row=rowFor(path);
+ return exact(row,source)&&row.views[view]?row.views[view].source:source;
+}
+function reader(project,read){return(path,encoding)=>{
+ const raw=read(path,encoding),text=typeof raw==='string'?raw:raw.toString('utf8'),prior=project(path,text);
+ return typeof raw==='string'?prior:prior===text?raw:Buffer.from(prior);
+};}
+export const releaseUnionViewRead=(view,read=readFileSync)=>reader((p,s)=>releaseUnionViewSource(p,s,view),read);
+export function releaseUnionCiCheckedSource(path,source,before){
+ const row=rowFor(path);
+ if(!row?.before||!exact(row,source)||(before&&before.sha256!==row.before.sha256))return source;
+ return row.before.source;
+}
+export function releaseUnionCiSource(path,source,before){
+ if(path.startsWith('src/')||path==='config/architecture.json')return source;
+ return releaseUnionCiCheckedSource(path,source,before);
+}
+export const releaseUnionCiRead=(read=readFileSync)=>reader(releaseUnionCiSource,read);
+export function assertReleaseUnionCiCurrent(read=readFileSync){
+ for(const [path,row]of Object.entries(packet.files))assert.equal(hash(norm(read(path,'utf8'))),row.current.sha256,'fresh complete integration source: PC bootstrap '+path);
+ for(const [path,sha]of Object.entries(packet.immutableArchives))assert.equal(hash(read(path)),sha,'retained complete immutable union predecessor: '+path);
+ assertReleasePcCiCurrent(releaseUnionViewRead('pc',read));
+ assertReleaseBootstrapCiCurrent(releaseUnionViewRead('bootstrap',read));
+}
+export function assertReleaseUnionRawInventory(paths,kind='js'){
+ assert(['js','lua'].includes(kind));assert.deepEqual([...paths].sort(),packet.currentInventory[kind],'complete union raw discovery inventory');
+}
+export function releaseUnionPriorInventory(paths,kind='js',read=readFileSync){
+ return releasePcPriorInventory(paths,kind,releaseUnionViewRead('pc',read));
+}
