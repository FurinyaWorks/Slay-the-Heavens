+import test from 'node:test';
+import assert from 'node:assert/strict';
+import crypto,{createHash} from 'node:crypto';
+import {syncBuiltinESMExports} from 'node:module';
+import {createSourceEpochProjector} from './helpers/combined-epoch/source-epoch-runtime.mjs';
+const path='src/lua/cache_proof.lua';
+const bind=source=>({source,sha256:createHash('sha256').update(source).digest('hex'),gitBlob:createHash('sha1').update(`blob ${Buffer.byteLength(source)}\0`).update(source).digest('hex')});
+function fixture(){return {schemaVersion:1,normalization:'LF',currentCommit:'a'.repeat(40),owners:[path],current:{[path]:bind('return "digest-current"\n')},targets:{prior:{commit:'b'.repeat(40),files:{[path]:bind('return "digest-prior"\n')}}}};}
+test('repeated binding text reuses pure digests but compares each declaration',()=>{
+ const input=fixture();const original=crypto.createHash;let calls=0;
+ try{
+  crypto.createHash=(...args)=>{calls++;return original(...args);};syncBuiltinESMExports();
+  createSourceEpochProjector(input);const first=calls;assert.ok(first>0);
+  createSourceEpochProjector(input);assert.equal(calls,first,'same complete texts do not repeat digest calculation');
+  for(const field of ['sha256','gitBlob']){
+   const invalid=structuredClone(input);invalid.current[path][field]='0'.repeat(field==='sha256'?64:40);
+   assert.throws(()=>createSourceEpochProjector(invalid),/source identity/);
+  }
+  const target=structuredClone(input);target.targets.prior.files[path].gitBlob='0'.repeat(40);
+  assert.throws(()=>createSourceEpochProjector(target),/source identity Git blob/);
+  const inherited=structuredClone(input);delete inherited.current[path].gitBlob;
+  const descriptor=Object.getOwnPropertyDescriptor(Object.prototype,'gitBlob');
+  try{
+   Object.defineProperty(Object.prototype,'gitBlob',{value:'0'.repeat(40),configurable:true});
+   assert.throws(()=>createSourceEpochProjector(inherited),/source identity Git blob/);
+  }finally{if(descriptor)Object.defineProperty(Object.prototype,'gitBlob',descriptor);else delete Object.prototype.gitBlob;}
+  const crlf=structuredClone(input);crlf.current[path].source=crlf.current[path].source.replaceAll('\n','\r\n');
+  assert.throws(()=>createSourceEpochProjector(crlf),/source identity LF/);
+  const project=createSourceEpochProjector(input);let actual=input.current[path].source,reads=0;
+  const run=()=>project.preCombinedSource(path,input.current[path].source,{target:'prior',readSource:()=>{reads++;return actual;}});
+  assert.equal(run(),input.targets.prior.files[path].source);actual+='-- drift';assert.throws(run,/linked owner identity/);assert.equal(reads,2);
+ }finally{crypto.createHash=original;syncBuiltinESMExports();}
+});
+
+test('binding digest cache evicts by both retained text and entry limits',()=>{
+ const proof=source=>({schemaVersion:1,normalization:'LF',currentCommit:'c'.repeat(40),owners:[],current:{[path]:bind(source)},targets:{}});
+ const first=proof('return "eviction-first"\n');
+ const small=Array.from({length:1024},(_,i)=>proof(`return "eviction-${i}"\n`));
+ const largeA=proof('a'.repeat(4*1024*1024+1)),largeB=proof('b'.repeat(4*1024*1024+1));
+ const oversized=proof('z'.repeat(8*1024*1024+1));
+ const original=crypto.createHash;let calls=0;
+ try{
+  crypto.createHash=(...args)=>{calls++;return original(...args);};syncBuiltinESMExports();
+  createSourceEpochProjector(first);const initial=calls;createSourceEpochProjector(first);assert.equal(calls,initial);
+  for(const input of small)createSourceEpochProjector(input);
+  let before=calls;createSourceEpochProjector(first);assert.equal(calls-before,2,'oldest entry recomputed');
+  createSourceEpochProjector(largeA);createSourceEpochProjector(largeB);
+  before=calls;createSourceEpochProjector(largeA);assert.equal(calls-before,2,'over-budget retained text evicts oldest');
+  before=calls;createSourceEpochProjector(oversized);createSourceEpochProjector(oversized);assert.equal(calls-before,4,'oversized complete text never retained');
+ }finally{crypto.createHash=original;syncBuiltinESMExports();}
+});
